# Copy this file to .env and complete the values. Never commit .env.

DB_HOST=localhost
DB_PORT=3306
DB_USER=docfiling
DB_PASSWORD=change-me
DB_NAME=document_filing

# Folder where new PDFs are dropped, and the root of the filing tree on the NAS
INBOX_DIR=/mnt/nas/Inbox
NAS_ROOT=/mnt/nas/Documents

# Classification: minimum keyword score, and minimum lead over the runner-up
MIN_SCORE=4
MIN_MARGIN=2

# Optional: Tesseract location on Windows
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional: email for the expiry summary. Leave SMTP_HOST blank to print instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=
