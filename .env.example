# Copy this file to .env and complete the values. Never commit .env.
#
# Only the database connection and the SMTP password live here. Every other
# parameter (NAS root, inbox, thresholds, phrases, property matching, alert
# addresses) is held in the document_filing database.

DB_HOST=localhost
DB_PORT=3306
DB_USER=docfiling
DB_PASSWORD=change-me
DB_NAME=document_filing

# Only needed if alert emails are sent (the SMTP host and user are database settings)
SMTP_PASSWORD=
